// Figure 2: Path-Sensitivity

struct Pos2D<T> { x: T, y: T }

fn dec_max(pos: &mut Pos2D<i32>, mut z: i32) {
    let max2 = if pos.x > pos.y {
        &mut pos.x
    } else {
        &mut pos.y
    };
    let max3 = if z > *max2 {
        pos.x = 0;
        &mut z
    } else {
        &mut *max2
    };
    *max3 -= 1;
}

fn main() {}
