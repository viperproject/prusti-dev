// Figure 5: Nested Lifetimes (inlined replace_x_ref)

struct Pos2D<T> { x: T, y: T }

fn cl<'a>(r1: &'a mut i32, r2: &'a mut i32,
          r3: &'a mut i32, r4: &'a mut i32) {
    let mut f = Pos2D { x: r1, y: r2 };
    let rf = &mut f;
    (*rf).y = r3;
    (*rf).x = r4;
    *f.x = 0;
}

fn main() {}
